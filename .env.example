# Web server
PORT=3000
SESSION_SECRET=replace-with-a-long-random-string

# Turn timeout. 180000 = 3 minutes.
TURN_TIMEOUT_MS=180000

# LLM provider configuration
# Use "mock" for local demo without an API key.
# Use "openai-compatible" for OpenAI, DeepSeek, SiliconFlow, OpenRouter, etc.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.85
LLM_TIMEOUT_MS=45000
# Estimated token budget for historical messages included in LLM prompts. Default supports up to ~256k-token contexts.
LLM_CONTEXT_TOKEN_BUDGET=256000
# Failed LLM calls are retried this many times before pausing for manual retry.
LLM_MAX_RETRIES=3
# For providers/models that support reasoning effort. "high" is the highest common OpenAI-compatible value.
# Set to "off" if your provider rejects this parameter.
LLM_THINKING_EFFORT=high
# Enable verbose LLM request/response debugging. Console logs truncate message content;
# the log file keeps full prompt/response bodies. Do not enable in production unless protected.
LLM_DEBUG_LOG=false
LLM_DEBUG_LOG_FILE=data/llm-debug.log

# Provider examples:
# DeepSeek:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
#
# OpenRouter:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
